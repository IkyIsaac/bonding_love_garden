# Local dev / Edge Function secrets. Copy to .env and fill in — never commit
# the real file. Supabase CLI reads this for `supabase start` / functions serve.

# Populated automatically by `supabase start` for local dev; set explicitly
# for `supabase functions deploy` against a real project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Payment providers — one block per provider registered in the
# `payment_providers` table (see docs/ARCHITECTURE_PLAN.md §4). Add a new
# block here (and a row in `payment_providers`) to onboard a provider;
# never hardcode credentials in function code.
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_WEBHOOK_SECRET=

SNIPPE_API_KEY=
SNIPPE_WEBHOOK_SECRET=

PAYGUARD_API_KEY=
PAYGUARD_WEBHOOK_SECRET=

# SMS/OTP provider: intentionally left unset (see docs/ARCHITECTURE_PLAN.md
# §4/§8). Supabase Auth's phone provider is configured in the Dashboard, not
# via this file — dev/UAT uses Supabase's built-in test phone numbers until
# real provider details are supplied.

# FCM (supervisor purchase alerts, customer notifications)
FCM_SERVER_KEY=
